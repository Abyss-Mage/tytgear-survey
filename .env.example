# ==============================================================================
# TYTGEAR Market Research Survey - Environment Variables
# ==============================================================================
# IMPORTANT: Never commit actual credentials (.env or .env.local) to Git!
# Only configure these in your local .env.local file or in Vercel Project Settings.

# ------------------------------------------------------------------------------
# Google Cloud Service Account Credentials (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# 1. Google Cloud Service Account Email (e.g., from IAM & Admin)
GOOGLE_SERVICE_ACCOUNT_EMAIL="tytgear-survey-sa@tytgear-market-research.iam.gserviceaccount.com"

# 2. Google Cloud Service Account Private Key (including BEGIN and END markers)
# Note: When setting in Vercel or .env, newlines can be formatted as \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Google Spreadsheet ID (from the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID="1A2B3C4D5E6F7G8H9I0J_your_google_sheet_id_here"

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Set to 'true' during local offline testing to store submissions in .data/submissions.json
# when Google Cloud credentials are not yet configured. In production, this should be 'false'.
ALLOW_LOCAL_SUBMISSION_FALLBACK="true"
